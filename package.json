{
  "name": "foxbidi",
  "version": "2.9.1",
  "private": true,
  "type": "module",
  "description": "Drive a real Firefox via WebDriver BiDi from MCP tools — zero npm dependencies.",
  "license": "MIT",
  "author": "DEGTHEDIG <143599314+DsDG1@users.noreply.github.com>",
  "homepage": "https://github.com/DsDG1/foxbidi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DsDG1/foxbidi.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js test/integration/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node tools/validate-package.mjs",
    "contract": "node tools/check-host-contract.mjs",
    "publish": "node tools/publish.mjs",
    "publish:dry": "node tools/publish.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
